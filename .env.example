# Required: create your bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Required: your personal numeric Telegram user ID.
# The bot rejects every other Telegram account.
TELEGRAM_USER_ID=123456789

# Folder whose immediate subdirectories become selectable projects.
PROJECT_ROOT=~/proyekku

# Antigravity CLI executable. Default installer path on Linux/macOS:
AGY_PATH=~/.local/bin/agy

# Persistent bot state, logs and backups.
BOT_DATA_DIR=~/.local/share/antigravity-telegram-bot

# IANA timezone used for quota reset times/history.
TIMEZONE=UTC

# Workarounds / tuning. Enable IPv4 only if Telegram HTTPS over IPv6 fails on your host.
TELEGRAM_FORCE_IPV4=false
AGY_GODEBUG=netdns=cgo
AGY_PRINT_TIMEOUT=10m
AGY_TASK_TIMEOUT=30m

# Directory names excluded from ZIP backups.
BACKUP_EXCLUDE=.venv,node_modules,__pycache__,.cache
